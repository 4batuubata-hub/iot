    {
        "id": "8f25223877f3218d",
        "type": "function",
        "z": "9cb20855f2850f4e",
        "name": "detect nik + level",
        "func": "let mcID = String(msg.payload.mcID || '').trim();\nlet op_NIK = String(msg.payload.op_NIK || '').trim();\n\n// Query SQL menggunakan Parameter (?)\nmsg.topic = \"SELECT o.nik as nik_asli, o.nama, IFNULL(s.skill_level, 0) as skill_level \" +\n  \"FROM master_operator o \" +\n  \"LEFT JOIN skill_matrix s ON o.nik = s.nik_operator AND s.mcID IN (SELECT mcID FROM master_mesin WHERE mcID = ? OR id_mesin = ?) \" +\n  \"WHERE (o.nik = ? OR o.uid_kartu = ?);\";\n\n// Ada 4 tanda tanya, jadi array payload HARUS ada 4 item.\nmsg.payload = [mcID, mcID, op_NIK, op_NIK];\n\nnode.warn(\"YANG DIKIRIM ESP32 - mcID: \" + mcID + \", UID/NIK: \" + op_NIK);\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 520,
        "y": 220,
        "wires": [
            [
                "7fa0dff76c8e399c",
                "a97f7dadd28cccc7"
            ]
        ]
    },
