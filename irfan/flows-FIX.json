    {
        "id": "13269420c3773c25",
        "type": "function",
        "z": "9cb20855f2850f4e",
        "name": "bales mesin",
        "func": "let rows = msg.payload;\nmsg.topic = \"SMMS/Reply/Setup\";\nlet outPayload = {};\nif (rows && rows.length > 0) {\n    outPayload = {\n        status: \"registered\",\n        mcID: rows[0].mcID,\n        id_mesin: rows[0].id_mesin\n    };\n} else {\n    outPayload = { status: \"failed\" };\n}\nmsg.payload = JSON.stringify(outPayload);\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 940,
        "y": 140,
