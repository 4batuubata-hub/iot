        "type": "function",
        "z": "9cb20855f2850f4e",
        "name": "bales kode proses",
        "func": "let rows = msg.payload;\nmsg.topic = \"SMMS/Reply/Proses\";\nlet outPayload = {};\n\nif (rows && rows.length > 0) {\n    outPayload = {\n        status: \"found\",\n        nama_part: rows[0].part_name,\n        part_no: rows[0].part_number,\n        nama_proses: rows[0].proses_description || ''\n    };\n} else {\n    outPayload = { status: \"not_found\" };\n}\nmsg.payload = JSON.stringify(outPayload);\nreturn msg;",
