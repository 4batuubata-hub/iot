    {
        "id": "a1f21431ee2b54b4",
        "type": "function",
        "z": "9cb20855f2850f4e",
        "name": "bales skill map",
        "func": "let rows = msg.payload;\nmsg.topic = \"SMMS/Reply/Login\";\nlet outPayload = {};\n\nif (rows && rows.length > 0) {\n    let skill = rows[0].skill_level;\n    if (skill >= 3) {\n        outPayload = { status: \"success\", nik_asli: rows[0].nik_asli, nama: rows[0].nama, level: skill };\n    } else {\n        outPayload = { status: \"skill_low\" };\n    }\n} else {\n    outPayload = { status: \"unregistered\" };\n}\nmsg.payload = JSON.stringify(outPayload);\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 960,
        "y": 220,
        "wires": [
            [
                "f315ea4e4a7e11c1"
            ]
        ]
    },
